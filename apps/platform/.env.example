# ============================================================================
# LAREI platform (apps/platform)
# Copy to .env.local. Never commit real values.
#
# Two database URLs, on purpose:
#   DATABASE_URL        the application role (larei_app). RLS applies to it.
#   DATABASE_URL_ADMIN  the owner role. Migrations, policies, operator tasks only.
# See docs/SECURITY.md before pointing these at a production branch.
# ============================================================================

# Neon Postgres — application role
DATABASE_URL=postgresql://larei_app:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Postgres — owner role (migrations, db:policies)
DATABASE_URL_ADMIN=postgresql://owner:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Better Auth — 32+ random bytes: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5174
# Extra origins allowed to post to the auth endpoints (comma separated, optional)
EXTRA_TRUSTED_ORIGINS=
# Operator addresses that may sign in without holding an invitation
ADMIN_EMAILS=

# Salt for hashed visitor and rate-limit identifiers. Rotating it invalidates old hashes,
# which is the point. Generate: openssl rand -hex 32
ANALYTICS_HASH_SALT=

# Groq (AI drafting, M3)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Calder (transactional email) — https://calder.click
# Keys look like calder_sk_test_... / calder_sk_live_...
CALDER_API_KEY=
CALDER_API_URL=https://api.calder.click/v1
MAIL_FROM=LAREI <hello@orvnlabs.com>
# Where early-access requests are delivered. Reply-to is the applicant.
EARLY_ACCESS_INBOX=danieloyegoke001@gmail.com

# Cloudflare R2 (property media). Private bucket; served only through /api/media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=larei-media

# Optional
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
