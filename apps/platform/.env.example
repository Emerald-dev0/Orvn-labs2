# ============================================================================
# ORREI platform (apps/platform)
# Copy to .env.local. Never commit real values.
# Where each value comes from, and the order to collect them: docs/env-setup.md
#
# Two database URLs, same Neon user, different hostnames:
#   DATABASE_URL        the pooled string (host contains -pooler). The app uses this.
#   DATABASE_URL_ADMIN  the direct string. Migrations and db:policies only.
# Row level security does NOT come from the role you connect with: the app connects
# as the owner and demotes itself per transaction with SET LOCAL ROLE orrei_app.
# Walkthrough: docs/neon-setup.md ·  verify with: npm run db:status
# ============================================================================

# Neon Postgres — pooled connection (Neon → Connect → Pooled)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Postgres — direct connection (same user, no -pooler in the host)
DATABASE_URL_ADMIN=postgresql://neondb_owner:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth — 32+ random bytes: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5174
# Extra origins allowed to post to the auth endpoints (comma separated, optional)
EXTRA_TRUSTED_ORIGINS=
# Operator addresses that may sign in without holding an invitation, and the only
# addresses that can open /admin. Use the address you actually sign in with.
ADMIN_EMAILS=danieloyegoke001@gmail.com

# Salt for hashed visitor and rate-limit identifiers. Rotating it invalidates old hashes,
# which is the point. Generate: openssl rand -hex 32
ANALYTICS_HASH_SALT=

# Groq (AI drafting, M3)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Calder (transactional email) — https://calder.click
# Calder dashboard → project → API keys. Shown once, looks like calder_sk_live_...
CALDER_API_KEY=
CALDER_API_URL=https://api.calder.click/v1
# Must match a verified sender identity in Calder exactly, or the API accepts the
# request and nothing is delivered. Add `hello@orvnlabs.com` (display name ORREI)
# under Domains & DNS before relying on it.
MAIL_FROM=ORREI <hello@orvnlabs.com>
# Where early-access and inquiry notifications are delivered. Reply-to is the applicant.
# Receiving side is Cloudflare Email Routing; early@orvnlabs.com forwards to a real inbox.
EARLY_ACCESS_INBOX=danieloyegoke001@gmail.com

# Cloudflare R2 (property media). Private bucket; served only through /api/media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orrei-media

# Optional
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
