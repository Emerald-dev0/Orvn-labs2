# ============================================================================
# LAREI platform (apps/platform)
# Copy to .env.local. Never commit real values.
# ============================================================================

# Neon Postgres. Project dashboard -> Connection string (pooled).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5174

# Groq (AI drafting, M3)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Resend (invitations, sign-in links, inquiry notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxx
FROM_EMAIL=hello@orvnlabs.com

# Cloudflare R2 (property media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=larei-media

# Optional
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
